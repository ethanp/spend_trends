# Required for ethan_sync (local store + multi-device).
POWERSYNC_JWT_SECRET=
SERVER_HOST_LAN=
SERVER_HOST_TAILSCALE=

# Optional LLM category suggestions (must match infra LLM_SPEND_TRENDS_SECRET).
LLM_APP_NAME=spend_trends
LLM_APP_SECRET=

# Claimed SimpleFIN Access URL (https://user:pass@bridge.../simplefin).
# Not the one-time Setup Token. Survives reinstall if you keep this file.
SIMPLEFIN_ACCESS_URL=

# Loopback agent API for categorization audits (macOS app only).
# Any random string; scripts/agent_api reads it from .env.
AGENT_API_TOKEN=
AGENT_API_PORT=8791
