# spend_trends .env: copy to .env (gitignored, bundled as a Flutter asset).
# Every app's .env.example has this shape: the shared sync keys, then the
# keys only this app reads.
#
# Home-server hosts come from ethan_sync/home_server.env. Set SERVER_HOST_LAN /
# SERVER_HOST_TAILSCALE here only to point this app at its own backend.

# Signs this app's PowerSync JWTs. The server's SPEND_TRENDS_POWERSYNC_JWT_KEY is
# its base64 form; infra/provision-sync-app.sh writes both.
POWERSYNC_JWT_SECRET=

# Optional LLM proxy access. Must match the server's LLM_SPEND_TRENDS_SECRET.
LLM_APP_NAME=spend_trends
LLM_APP_SECRET=

# Claimed SimpleFIN Access URL (https://user:pass@bridge.../simplefin).
# Not the one-time Setup Token. Survives reinstall if you keep this file.
SIMPLEFIN_ACCESS_URL=

# Loopback agent API for categorization audits (macOS app only).
# Any random string; scripts/agent_api reads it from .env.
AGENT_API_TOKEN=
AGENT_API_PORT=8791
